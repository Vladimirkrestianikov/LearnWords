# LearnWords configuration
# Copy this file to .env and fill in your own values:  cp .env.example .env

# Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace-with-your-bot-token

# OpenAI API key and model
OPENAI_API_KEY=sk-replace-with-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Telegram IDs of admins, comma-separated (find yours via @userinfobot)
ADMIN_IDS=123456789

# Database (SQLite file is created automatically)
DATABASE_URL=sqlite+aiosqlite:///data/learnwords.db

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Max size of an uploaded vocabulary file, MB
MAX_UPLOAD_SIZE_MB=10

# Minimum seconds between messages from one user (anti-spam)
RATE_LIMIT_SECONDS=0.5
